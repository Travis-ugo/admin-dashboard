# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env*.example
!.env.example

# Firebase credentials and service accounts (DO NOT commit)
service-account.json
firebase-key.json
*.local.json

# eslint / log files
eslint-errors.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
